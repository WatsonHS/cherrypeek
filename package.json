    "test:protocol": "node scripts/test-protocol.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "test:repository": "node scripts/test-repository.mjs --ui-smoke",
    "benchmark:first-screen": "node scripts/benchmark-first-screen.mjs",
    "build:reader-bench": "cargo build --release --locked -p commitscope-daemon --example reader_bench",
    "benchmark:readers": "node scripts/benchmark-readers.mjs",
    "test:readers": "node scripts/test-readers.mjs",
    "test:sessions": "node scripts/test-sessions.mjs",
    "test:history": "node scripts/test-history.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:indexing": "node scripts/test-indexing.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:search:project": "node scripts/test-search.mjs --real-repository",
    "test:smoke:metadata-index": "node tests/smoke/metadata-index-smoke.mjs",
    "test:smoke:metadata-search": "node tests/smoke/metadata-search-smoke.mjs",
    "test:graph": "node scripts/test-graph.mjs",
    "test:details": "node scripts/test-details.mjs",
    "test:smoke:commit-details": "node tests/smoke/commit-details-smoke.mjs",
    "test:smoke:history-graph": "node tests/smoke/history-graph-smoke.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test:smoke:pages": "node tests/smoke/pages-smoke.mjs",
    "test:smoke:pages:stand-in": "node tests/smoke/pages-smoke.mjs --stand-in",
    "test:smoke:operations": "node tests/smoke/m5-operations-smoke.mjs",
    "test:smoke:m7": "pnpm build && node tests/smoke/m7-review-gate-smoke.mjs",
    "test:smoke:m8": "pnpm build && node tests/smoke/m8-three-pane-merge-smoke.mjs",
    "test:smoke:stats": "node tests/smoke/stats-page-smoke.mjs",
    "test:smoke:batch-review": "node tests/smoke/batch-review-smoke.mjs",
    "fixtures:graph-benchmark": "node scripts/generate-graph-benchmark-fixture.mjs",
    "benchmark:history-scroll:graph": "node scripts/benchmark-history-scroll.mjs",
    "benchmark:graph-interactions": "node scripts/benchmark-history-scroll.mjs --graph-interactions",
    "benchmark:history": "node scripts/benchmark-history.mjs",
    "benchmark:history-scroll": "node scripts/benchmark-history-scroll.mjs",
    "test:renderer": "node scripts/test-renderer.mjs"
