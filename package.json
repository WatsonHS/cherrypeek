    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "package:mac": "node scripts/package-macos.mjs",
    "release:mac": "node scripts/release-macos.mjs",
    "licenses:third-party": "node scripts/third-party-licenses.mjs",
    "icon:mac": "node scripts/build-icon.mjs",
    "test:smoke:package": "node tests/smoke/packaged-app-smoke.mjs",
    "test:smoke:command-palette": "node tests/smoke/command-palette-smoke.mjs",
    "dev": "node scripts/launch.mjs --build",
    "start": "node scripts/launch.mjs",
    "test:smoke": "node tests/smoke/electron-smoke.mjs",
    "test:smoke:history": "node tests/smoke/history-pagination-smoke.mjs",
    "test:smoke:fetch-history": "node tests/smoke/fetch-history-smoke.mjs",
    "test:smoke:update-current": "node tests/smoke/update-current-smoke.mjs",
