{
  "name": "commitscope",
  "private": true,
  "version": "0.1.0",
  "author": "Sheng Huang",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": "26.0.0" },
  "scripts": {
    "protocol:generate": "node scripts/protocol-generate.mjs",
    "protocol:check": "node scripts/protocol-check.mjs",
