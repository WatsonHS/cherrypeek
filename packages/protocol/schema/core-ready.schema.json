{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Capability": {
      "oneOf": [
        {
          "enum": [
            "getRuntimeInfo",
            "readRepositoryPreview",
            "repositorySessions",
            "historyPagination",
            "historyNewSinceLastSeen",
            "repositoryScopes",
            "metadataIndex",
            "metadataSearch",
            "historyGraph",
            "commitDetails",
            "activityStats",
            "activityOverview",
            "changeStats",
            "notableStats",
            "evolution",
            "repositoryObservation",
            "handoffFacts"
          ],
          "type": "string"
        },
        {
          "const": "workspaceStatus",
          "description": "P4-09. Declared in `CoreReady` only once the daemon implements the workspace reads.",
          "type": "string"
        },
        {
          "const": "fileBrowsing",
          "description": "P4-10: tree listing, file content, file history and per-file changes at a commit.",
          "type": "string"
        },
        {
          "const": "diffFullContext",
          "description": "P4-11: `fullFile` on diff requests returns the whole file as context.",
          "type": "string"
        },
        {
          "const": "blame",
          "description": "P4-12: line-by-line blame.",
          "type": "string"
        },
        {
          "const": "repositoryOperations",
          "description": "P5-01: user-triggered operations that write to the repository or use the network. Fetch first.",
          "type": "string"
        }
      ]
    },
    "GitInfo": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "error": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "version",
        "error"
      ],
      "type": "object"
    }
  },
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "type": "array"
    },
    "coreVersion": {
      "type": "string"
    },
    "git": {
      "$ref": "#/definitions/GitInfo"
    },
    "pid": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "protocolVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocolVersion",
    "coreVersion",
    "pid",
    "git",
    "capabilities"
  ],
  "title": "CoreReady",
  "type": "object"
}
