{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Capability": {
      "enum": [
        "getRuntimeInfo",
        "readRepositoryPreview",
        "repositorySessions",
        "historyPagination",
        "historyNewSinceLastSeen",
        "repositoryScopes",
        "metadataIndex",
        "metadataSearch",
        "historyGraph",
        "commitDetails",
        "activityStats",
        "repositoryObservation",
        "handoffFacts"
      ],
      "type": "string"
    },
    "GitInfo": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "error": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "version",
        "error"
      ],
      "type": "object"
    }
  },
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "type": "array"
    },
    "coreVersion": {
      "type": "string"
    },
    "git": {
      "$ref": "#/definitions/GitInfo"
    },
    "pid": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "protocolVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocolVersion",
    "coreVersion",
    "pid",
    "git",
    "capabilities"
  ],
  "title": "CoreReady",
  "type": "object"
}
