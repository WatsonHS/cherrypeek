        "gitDir": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "lastOpenedAtUnixMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "objectFormat": {
          "maxLength": 16,
