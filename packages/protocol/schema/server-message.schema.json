        "PROTOCOL_ERROR",
        "INVALID_REQUEST",
        "UNKNOWN_METHOD",
        "BUSY",
        "CANCELLED",
        "TIMEOUT",
        "CORE_EXITED",
        "STALE_CONTEXT",
        "GIT_UNAVAILABLE",
        "NOT_A_REPOSITORY",
        "REPOSITORY_UNAVAILABLE",
