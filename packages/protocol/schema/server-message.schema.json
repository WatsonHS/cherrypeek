        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "repoId": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "format": "uint32",
          "minimum": 0,
